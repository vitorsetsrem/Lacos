# =============================================
# LAÇO'S - MINHA SAÚDE FEMININA
# .gitignore - Proteção de Segurança do Projeto
# =============================================

# =============================================
# ARQUIVOS SENSÍVEIS - NUNCA VERSIONAR!
# =============================================

# Variáveis de ambiente (chaves Supabase, API keys, secrets)
.env
.env.*
*.env
!.env.example

# Android signing keys (chaves de assinatura APK/AAB)
*.jks
*.keystore
*.keystore.p12
key.properties
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# iOS certificates e provisioning profiles
*.p12
*.cer
*.mobileprovision
*.provisionprofile
/ios/*.mobileprovision
/ios/Runner/ExportOptions.plist

# Google Services (Firebase/Analytics)
google-services.json
GoogleService-Info.plist
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Scripts com credenciais
setup_e_teste.ps1
*.secret
*.credentials

# Tokens e sessões
*.token
*.session

# =============================================
# BUILD OUTPUTS (APK / AAB / IPA)
# =============================================

# Android build outputs
/build/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.aab

# iOS build outputs
/ios/build/
/ios/Pods/
*.ipa
*.dSYM.zip
*.dSYM
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Runner/GeneratedPluginRegistrant.*

# =============================================
# FLUTTER / DART
# =============================================

# Flutter/Dart/Pub related
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
*.dart.js
*.js_
*.js.deps
*.js.map

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# =============================================
# IDE E EDITORES
# =============================================

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
.idea/workspace.xml
.idea/libraries/

# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# =============================================
# SISTEMA OPERACIONAL
# =============================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# =============================================
# DIVERSOS
# =============================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.swo
*.tmp
*.bak
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local properties (caminhos SDK locais)
/android/local.properties
/ios/Flutter/Generated.xcconfig
/ios/.symlinks/

# Banco de dados local
*.db
*.sqlite
*.sqlite3
*.hive

# Crashlytics
crashlytics-build.properties

# Node (caso use ferramentas JS)
node_modules/
package-lock.json
